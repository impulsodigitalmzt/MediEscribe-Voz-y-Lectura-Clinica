# ===================================
# MedScribe — Cloudflare Workers
# ===================================
# Copy this file to .dev.vars for local `wrangler dev`.
# NEVER put real secrets in wrangler.toml or commit .dev.vars.
#
# Production secrets (injected by Cloudflare as env bindings):
#   npx wrangler secret put DATABASE_URL
#   npx wrangler secret put SECRET_KEY
#   npx wrangler secret put SUPABASE_URL
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   npx wrangler secret put GROQ_API_KEY
#   npx wrangler secret put WHATSAPP_TOKEN
#   npx wrangler secret put VERIFY_TOKEN
#   npx wrangler secret put WHATSAPP_APP_SECRET

# --- Application ---
APP_NAME=MedScribe
APP_VERSION=2.0.0
ENVIRONMENT=development

# --- Security (generate a random 64-char string) ---
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# --- Database (Supabase) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Database (Neon, HTTP serverless driver) ---
# Connection string from the Neon Console. The Worker uses
# @neondatabase/serverless over HTTP (no TCP / no Node net).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- AI (Groq) ---
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=YOUR_WHATSAPP_CLOUD_API_TOKEN
PHONE_NUMBER_ID=130281826638326
VERIFY_TOKEN=token_secreto_123
WHATSAPP_APP_SECRET=YOUR_META_APP_SECRET
WHATSAPP_GRAPH_VERSION=v21.0
